# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run ingest/retrieve only.

# --- Week 0–1: Fireworks (AMD program perk) or another cheap/free API ---
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=accounts/fireworks/models/qwen3-8b

# --- Week 2: AMD Developer Cloud MI300X running vLLM ---
# LLM_BASE_URL=http://YOUR_DROPLET_IP:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3-8B

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
COLLECTION_NAME=studyforge
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_K=5
