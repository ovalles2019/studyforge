# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to run ingest/retrieve only.
# Copy this file to .env and fill in a key. Never commit .env.

# --- Week 0–1: cheapest path that works tonight (OpenAI) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Week 0–1: AMD program perk (Fireworks). Prefer a serverless Qwen. ---
# Qwen3-8B on Fireworks is often on-demand only. Check https://fireworks.ai/models
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=accounts/fireworks/models/qwen3-235b-a22b

# --- Week 2: AMD Developer Cloud MI300X running vLLM ---
# LLM_BASE_URL=http://YOUR_DROPLET_IP:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen3-8B

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
COLLECTION_NAME=studyforge
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_K=5
